# Root-level gitignore for fixit-app-salman

# macOS
.DS_Store

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
Thumbs.db
ehthumbs.db
Desktop.ini

# IDEs and editors
.vscode/
.idea/
*.iml
*.sublime-project
*.sublime-workspace

# Laravel
fixit_laravel/vendor/
fixit_laravel/node_modules/
fixit_laravel/.env
fixit_laravel/.env.*
fixit_laravel/.phpunit.result.cache
fixit_laravel/phpunit.xml
fixit_laravel/phpunit.xml.dist
fixit_laravel/storage/
fixit_laravel/bootstrap/cache/*.php
fixit_laravel/public/storage
fixit_laravel/.phpstorm.meta.php
fixit_laravel/.idea/

# Laravel IDE helper
fixit_laravel/_ide_helper.php
fixit_laravel/_ide_helper_models.php

# Laravel Swoole / Horizon
fixit_laravel/horizon.sqlite
fixit_laravel/horizon.log

# Node/NPM
node_modules/
pnpm-lock.yaml
package-lock.json
yarn.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Flutter
fixit_provider/.dart_tool/
fixit_provider/build/
fixit_provider/.pub-cache/
fixit_provider/.idea/
fixit_provider/.flutter-plugins
fixit_provider/.flutter-plugins-dependencies
fixit_provider/.packages
fixit_provider/ios/Flutter/Flutter.framework
fixit_provider/ios/Flutter/Flutter.podspec
fixit_provider/ios/Flutter/Generated.xcconfig
fixit_provider/ios/Pods/
fixit_provider/ios/.symlinks/
fixit_provider/ios/Flutter/engine/Flutter.framework
fixit_provider/ios/Flutter/Flutter.podspec
fixit_provider/ios/ServiceDefinitions.json
fixit_provider/ios/Flutter/ephemeral/
fixit_provider/ios/Pods/
fixit_provider/android/.gradle/
fixit_provider/android/app/build/
fixit_provider/android/build/
fixit_provider/android/local.properties
fixit_provider/android/key.properties
fixit_provider/linux/flutter/ephemeral/
fixit_provider/macos/Flutter/ephemeral/
fixit_provider/web/manifest.json
fixit_provider/web/favicon.png
fixit_provider/test_driver/

fixit_user/.dart_tool/
fixit_user/build/
fixit_user/.pub-cache/
fixit_user/.idea/
fixit_user/.flutter-plugins
fixit_user/.flutter-plugins-dependencies
fixit_user/.packages
fixit_user/ios/Flutter/Flutter.framework
fixit_user/ios/Flutter/Flutter.podspec
fixit_user/ios/Flutter/Generated.xcconfig
