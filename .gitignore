# Environment files
*.env
*.env.*

# Package artifacts
*.zip
*.tar.gz
*.rar
*.7z
*.gz
*.bz2

# Generated files
*.class
*.jar
*.war
*.pyc
*.pyo
*.pyd
*.swp
*.swo
*~

# Coverage
coverage/
*.lcov

# Android Studio
captures/

# Flutter lockfiles: optionally version-controlled for apps, but ignore workspace-level generated files
fixit_provider/pubspec.lock
fixit_user/pubspec.lock
